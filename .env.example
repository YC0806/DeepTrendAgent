# DeepTrendAgent environment template
#
# Loaded by src/config.py at import time. Variables here populate
# `Settings` fields (matched by uppercase field name). Unknown variables
# are ignored — typos do not error, so spell-check before relying on
# overrides.

# --- GitHub access -------------------------------------------------------

# Optional GitHub API token for direct script runs. The cron wrapper obtains
# its token from the cron user's GitHub CLI login.
GITHUB_TOKEN=

# GitHub Web base URL. Override when targeting GitHub Enterprise.
GITHUB_BASE_URL=https://github.com

# GitHub API base URL.
GITHUB_API_BASE_URL=https://api.github.com

# Optional custom user agent. Empty falls back to provider defaults.
GITHUB_USER_AGENT=

# Optional HTTP(S) proxy for GitHub / raw.githubusercontent.com /
# trending-archive fetches. Leave empty if direct access works.
GITHUB_PROXY_URL=

# --- GitHub trending archive (first-run / diff history) -----------------

# Source repository for historical trending snapshots. The default upstream
# typically lags the current day by 1–2 days; switch to a private mirror
# if you need fresher archive coverage. fetch_snapshot.py reads from this
# repo when no previous run is available locally.
GITHUB_TRENDING_ARCHIVE_REPO_FULL_NAME=antonkomarev/github-trending-archive

# Ref (branch / tag / sha) to read archive entries from.
GITHUB_TRENDING_ARCHIVE_REF=main

# --- Local git tooling --------------------------------------------------

# git executable. Override only if `git` is not on PATH.
GIT_BIN=git

# Cache root for shallow clones used by the git provider. Defaults to
# <repo>/tmp/git-cache. Point elsewhere if you want a shared cache or
# different disk.
DEEPTREND_GIT_CACHE_ROOT=

# --- Run artifacts ------------------------------------------------------

# Root directory for run_dir trees (<root>/runs/<run_id>/...).
DEEPTREND_ARTIFACT_ROOT=output/trend

# --- Delivery -----------------------------------------------------------

# WeCom (企业微信) webhook key. When set, trend-run will deliver the
# digest + report attachment to this webhook. When empty, delivery is
# skipped — there is no separate enable/disable flag.
WECOM_WEBHOOK_KEY=

# --- Per-run variables (do NOT set here) --------------------------------
#
# DEEPTREND_RUN_DIR, DEEPTREND_RUN_ID, DEEPTREND_RUN_SLUG are emitted by
# `python3 src/scripts/init_run.py` at the start of every run. The
# orchestrator (trend-run skill) is responsible for threading them into
# subsequent script invocations — either by `export`-ing them in the same
# shell or by passing `--run-dir <dir>` explicitly. They change every
# run, so writing them into .env is meaningless and misleading.
