# Copy to /etc/deeptrend/deeptrend.env, fill in secrets, then chmod 600 it.
# This file is sourced by bin/run-deeptrend, so values containing spaces must be quoted.

# Persistent disk: do not put this under /tmp or an ephemeral container filesystem.
DEEPTREND_ARTIFACT_ROOT=/var/lib/deeptrend/trend
DEEPTREND_GIT_CACHE_ROOT=/var/lib/deeptrend/git-cache

# GitHub authentication comes from the cron user's gh login.
WECOM_WEBHOOK_KEY=
# GITHUB_PROXY_URL=

DEEPTREND_SINCE=daily
DEEPTREND_LANGUAGE=all
DEEPTREND_OUTPUT_LANGUAGE='简体中文'

# Optional: pin the OpenCode provider/model and agent configuration used by cron.
# OPENCODE_MODEL=provider/model
# OPENCODE_AGENT=default
