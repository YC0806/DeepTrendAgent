#!/usr/bin/env bash
# Runs one complete DeepTrend workflow through OpenCode. Designed for cron.
set -euo pipefail

SCRIPT_DIR="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="${DEEPTREND_APP_DIR:-$SCRIPT_DIR/..}"
ENV_FILE="${DEEPTREND_ENV_FILE:-/etc/deeptrend/deeptrend.env}"

if [[ ! -d "$APP_DIR/.opencode/skills" ]]; then
  echo "DeepTrend app directory is invalid: $APP_DIR" >&2
  exit 1
fi
# Keep the current run on this release if a deployment switches the app symlink.
APP_DIR="$(cd -P -- "$APP_DIR" && pwd)"
if [[ ! -r "$ENV_FILE" ]]; then
  echo "DeepTrend environment file is not readable: $ENV_FILE" >&2
  exit 1
fi
if ! command -v flock >/dev/null 2>&1; then
  echo "flock is required to prevent overlapping DeepTrend runs" >&2
  exit 1
fi

# The environment file is an operator-controlled KEY=value file (mode 0600).
set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

: "${DEEPTREND_ARTIFACT_ROOT:?DEEPTREND_ARTIFACT_ROOT must be set in $ENV_FILE}"
LOCK_FILE="${DEEPTREND_LOCK_FILE:-$DEEPTREND_ARTIFACT_ROOT/.deeptrend.lock}"
mkdir -p "$DEEPTREND_ARTIFACT_ROOT" "$(dirname -- "$LOCK_FILE")"

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "DeepTrend is already running; skipping this trigger." >&2
  exit 0
fi

OPENCODE_BIN="${OPENCODE_BIN:-opencode}"
if ! command -v "$OPENCODE_BIN" >/dev/null 2>&1; then
  echo "OpenCode executable not found: $OPENCODE_BIN" >&2
  exit 1
fi

SINCE="${DEEPTREND_SINCE:-daily}"
LANGUAGE="${DEEPTREND_LANGUAGE:-all}"
OUTPUT_LANGUAGE="${DEEPTREND_OUTPUT_LANGUAGE:-简体中文}"
case "$SINCE" in daily|weekly|monthly) ;; *) echo "Invalid DEEPTREND_SINCE: $SINCE" >&2; exit 1;; esac

args=(run --dir "$APP_DIR" --format json --auto)
if [[ -n "${OPENCODE_MODEL:-}" ]]; then
  args+=(-m "$OPENCODE_MODEL")
fi
if [[ -n "${OPENCODE_AGENT:-}" ]]; then
  args+=(--agent "$OPENCODE_AGENT")
fi

prompt="请使用 trend-run skill 跑一次完整的 DeepTrend workflow。since=${SINCE} language=${LANGUAGE} output_language=${OUTPUT_LANGUAGE}。跑完后返回 run_dir、report.md 路径、投递状态。"
cd "$APP_DIR"

if ! command -v gh >/dev/null 2>&1; then
  echo "GitHub CLI (gh) 2.103.0 or later must be on the cron PATH." >&2
  exit 1
fi

# Environment tokens override the saved gh login and cannot be refreshed.
unset GH_TOKEN GITHUB_TOKEN
# Set --no-refresh=false explicitly so older versions of gh fail here.
if ! GITHUB_TOKEN="$(GH_PROMPT_DISABLED=1 gh auth token --hostname github.com --no-refresh=false)" || [[ -z "$GITHUB_TOKEN" ]]; then
  echo "Could not get a GitHub token. Use gh 2.103.0 or later and run 'gh auth login --hostname github.com --expiring' as the cron user." >&2
  exit 1
fi
export GITHUB_TOKEN

"$OPENCODE_BIN" "${args[@]}" "$prompt"
